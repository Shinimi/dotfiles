/* Tokyo Night for Waterfox's own pages (new tab, settings). Made by Claude. */
@-moz-document url-prefix("about:") {
  :root { --in-content-page-background: #13121c !important; --in-content-box-background: #1b1928 !important;
          --in-content-text-color: #efeaf8 !important; --in-content-primary-button-background: #a28ae8 !important;
          --in-content-primary-button-text-color: #0d0c13 !important; --in-content-accent-color: #a28ae8 !important;
          --newtab-background-color: #13121c !important; --newtab-background-color-secondary: #1b1928 !important;
          --newtab-text-primary-color: #efeaf8 !important; --newtab-primary-action-background: #a28ae8 !important; }
}
