/* Tokyo Night for Waterfox. Made by Claude. */
:root {
  --tn-bg: #13121c; --tn-bg-dark: #0d0c13; --tn-bg-hl: #2a2640; --tn-fg: #efeaf8;
  --tn-muted: #807a9c; --tn-blue: #a28ae8; --tn-purple: #e39ec0; --tn-sel: #2f2950;

  --lwt-accent-color: var(--tn-bg-dark) !important;
  --lwt-text-color: var(--tn-fg) !important;
  --toolbar-bgcolor: var(--tn-bg) !important;
  --toolbar-color: var(--tn-fg) !important;
  --toolbar-field-background-color: var(--tn-bg-dark) !important;
  --toolbar-field-focus-background-color: var(--tn-bg-dark) !important;
  --toolbar-field-color: var(--tn-fg) !important;
  --toolbar-field-focus-color: var(--tn-fg) !important;
  --toolbar-field-border-color: var(--tn-bg-hl) !important;
  --toolbar-field-focus-border-color: var(--tn-blue) !important;
  --focus-outline-color: var(--tn-blue) !important;
  --tab-selected-bgcolor: var(--tn-bg-hl) !important;
  --tab-selected-textcolor: var(--tn-fg) !important;
  --tab-loading-fill: var(--tn-blue) !important;
  --tab-border-radius: 8px !important;
  --urlbarView-highlight-background: var(--tn-sel) !important;
  --urlbarView-highlight-color: var(--tn-fg) !important;
  --arrowpanel-background: var(--tn-bg) !important;
  --arrowpanel-color: var(--tn-fg) !important;
  --arrowpanel-border-color: var(--tn-bg-hl) !important;
  --sidebar-background-color: var(--tn-bg-dark) !important;
  --sidebar-text-color: var(--tn-fg) !important;
  --chrome-content-separator-color: transparent !important;
  --button-hover-bgcolor: rgba(239,234,248, 0.10) !important;
  --button-active-bgcolor: rgba(239,234,248, 0.18) !important;
  --identity-icon-color: var(--tn-blue) !important;
  --toolbarbutton-icon-fill-attention: var(--tn-blue) !important;
}
#navigator-toolbox { background: var(--tn-bg-dark) !important; border-bottom: none !important; }
#TabsToolbar, #titlebar { background: var(--tn-bg-dark) !important; }
.tab-background[selected] { background: var(--tn-bg-hl) !important; box-shadow: inset 0 -2px 0 var(--tn-blue) !important; }
.tabbrowser-tab:not([selected]):hover .tab-background { background: rgba(239,234,248, 0.06) !important; }
.tab-label[selected] { color: var(--tn-fg) !important; }
.tab-label:not([selected]) { color: var(--tn-muted) !important; }
#urlbar-background { border-radius: 10px !important; }
#urlbar[focused] #urlbar-background { box-shadow: 0 0 0 1px var(--tn-blue) !important; }
menupopup, panel { --panel-background: var(--tn-bg) !important; --panel-color: var(--tn-fg) !important; --panel-border-color: var(--tn-bg-hl) !important; }
::selection { background: var(--tn-sel) !important; color: var(--tn-fg) !important; }
