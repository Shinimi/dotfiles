/* Tokyo Night for Waterfox's own pages (new tab, settings). Made by Claude. */
@-moz-document url-prefix("about:") {
  :root { --in-content-page-background: #1a1b26 !important; --in-content-box-background: #1f2335 !important;
          --in-content-text-color: #c0caf5 !important; --in-content-primary-button-background: #7aa2f7 !important;
          --in-content-primary-button-text-color: #16161e !important; --in-content-accent-color: #7aa2f7 !important;
          --newtab-background-color: #1a1b26 !important; --newtab-background-color-secondary: #1f2335 !important;
          --newtab-text-primary-color: #c0caf5 !important; --newtab-primary-action-background: #7aa2f7 !important; }
}
