# Monochrome boot splash. Made by Claude.
Window.SetBackgroundTopColor(0.03, 0.03, 0.03);
Window.SetBackgroundBottomColor(0.06, 0.06, 0.06);
cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(cx - logo.image.GetWidth() / 2, cy - logo.image.GetHeight() / 2 - 60, 1);
logo.sprite.SetOpacity(0);

title.image = Image("title.png");
title.sprite = Sprite(title.image);
title.sprite.SetPosition(cx - title.image.GetWidth() / 2, cy + logo.image.GetHeight() / 2 - 20, 1);
title.sprite.SetOpacity(0);

for (i = 0; i < 36; i++) {
  n = i; if (n < 10) n = "0" + n;
  spin[i] = Image("spin-" + n + ".png");
}
spinner = Sprite();
spinner.SetPosition(cx - 28, Window.GetY() + Window.GetHeight() * 0.78, 1);

frame = 0; t = 0;
fun refresh() {
  t++;
  if (t < 40) { o = t / 40; logo.sprite.SetOpacity(o); title.sprite.SetOpacity(o * 0.8); }
  frame = (frame + 1) % 36;
  spinner.SetImage(spin[frame]);
}
Plymouth.SetRefreshFunction(refresh);

# password prompt (only used with disk encryption)
fun display_password(prompt, bullets) {
  pw.image = Image.Text(prompt + "  " + bullets, 0.93, 0.89, 0.96, 1, "JetBrainsMono Nerd Font 14");
  pw.sprite = Sprite(pw.image);
  pw.sprite.SetPosition(cx - pw.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() * 0.7, 2);
}
fun display_normal() { pw.sprite = NULL; }
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);

fun message(text) {
  msg.image = Image.Text(text, 0.49, 0.45, 0.6, 1, "JetBrainsMono Nerd Font 11");
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetPosition(cx - msg.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 40, 2);
}
Plymouth.SetMessageFunction(message);
