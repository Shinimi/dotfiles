# Let the desktop read battery levels from the VXE mouse dongle and the Fuxi-H3 headset (no root needed).
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", ATTRS{idProduct}=="f58e", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="040b", ATTRS{idProduct}=="0897", TAG+="uaccess"
