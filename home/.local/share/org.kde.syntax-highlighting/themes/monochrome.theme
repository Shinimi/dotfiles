{
    "_comments": ["Monochrome code colours for Kate and other KDE editors: weight and shade instead of hue. Made by Claude."],
    "metadata": { "name": "Monochrome", "revision": 1, "license": "MIT", "author": "Claude" },
    "text-styles": {
        "Normal":         { "text-color": "#d0d0d0", "selected-text-color": "#ffffff" },
        "Keyword":        { "text-color": "#ffffff", "selected-text-color": "#ffffff", "bold": true },
        "Function":       { "text-color": "#f2f2f2", "selected-text-color": "#ffffff" },
        "Variable":       { "text-color": "#c8c8c8", "selected-text-color": "#ffffff" },
        "ControlFlow":    { "text-color": "#ffffff", "selected-text-color": "#ffffff", "bold": true },
        "Operator":       { "text-color": "#9a9a9a", "selected-text-color": "#ffffff" },
        "BuiltIn":        { "text-color": "#e6e6e6", "selected-text-color": "#ffffff", "italic": true },
        "Extension":      { "text-color": "#e0e0e0", "selected-text-color": "#ffffff" },
        "Preprocessor":   { "text-color": "#b0b0b0", "selected-text-color": "#ffffff" },
        "Attribute":      { "text-color": "#bdbdbd", "selected-text-color": "#ffffff" },
        "Char":           { "text-color": "#a8a8a8", "selected-text-color": "#ffffff" },
        "SpecialChar":    { "text-color": "#c4c4c4", "selected-text-color": "#ffffff" },
        "String":         { "text-color": "#a8a8a8", "selected-text-color": "#ffffff" },
        "VerbatimString": { "text-color": "#a8a8a8", "selected-text-color": "#ffffff" },
        "SpecialString":  { "text-color": "#bdbdbd", "selected-text-color": "#ffffff" },
        "Import":         { "text-color": "#b0b0b0", "selected-text-color": "#ffffff" },
        "DataType":       { "text-color": "#e6e6e6", "selected-text-color": "#ffffff", "bold": true },
        "DecVal":         { "text-color": "#dcdcdc", "selected-text-color": "#ffffff" },
        "BaseN":          { "text-color": "#dcdcdc", "selected-text-color": "#ffffff" },
        "Float":          { "text-color": "#dcdcdc", "selected-text-color": "#ffffff" },
        "Constant":       { "text-color": "#ececec", "selected-text-color": "#ffffff", "bold": true },
        "Comment":        { "text-color": "#5e5e5e", "selected-text-color": "#9a9a9a", "italic": true },
        "Documentation":  { "text-color": "#6e6e6e", "selected-text-color": "#9a9a9a", "italic": true },
        "Annotation":     { "text-color": "#7a7a7a", "selected-text-color": "#9a9a9a" },
        "CommentVar":     { "text-color": "#8a8a8a", "selected-text-color": "#9a9a9a" },
        "RegionMarker":   { "text-color": "#7a7a7a", "selected-text-color": "#9a9a9a", "background-color": "#1a1a1a" },
        "Information":    { "text-color": "#c8c8c8", "selected-text-color": "#ffffff" },
        "Warning":        { "text-color": "#e0e0e0", "selected-text-color": "#ffffff", "underline": true },
        "Alert":          { "text-color": "#ffffff", "selected-text-color": "#ffffff", "background-color": "#3a3a3a", "bold": true },
        "Error":          { "text-color": "#cf6b6b", "selected-text-color": "#cf6b6b", "underline": true },
        "Others":         { "text-color": "#bdbdbd", "selected-text-color": "#ffffff" }
    },
    "editor-colors": {
        "BackgroundColor": "#111111", "CodeFolding": "#1c1c1c", "BracketMatching": "#3a3a3a",
        "CurrentLine": "#171717", "IconBorder": "#0e0e0e", "IndentationLine": "#222222",
        "LineNumbers": "#3e3e3e", "CurrentLineNumber": "#d0d0d0", "MarkBookmark": "#7a7a7a",
        "MarkBreakpointActive": "#cf6b6b", "MarkBreakpointReached": "#e0e0e0", "MarkBreakpointDisabled": "#4a4a4a",
        "MarkExecution": "#d0d0d0", "MarkWarning": "#e0e0e0", "MarkError": "#cf6b6b",
        "ModifiedLines": "#7a7a7a", "ReplaceHighlight": "#4a4a4a", "SavedLines": "#3a3a3a",
        "SearchHighlight": "#3a3a3a", "TextSelection": "#2e2e2e", "Separator": "#1f1f1f",
        "SpellChecking": "#cf6b6b", "TabMarker": "#2a2a2a", "TemplateBackground": "#1a1a1a",
        "TemplatePlaceholder": "#2a2a2a", "TemplateFocusedPlaceholder": "#3a3a3a", "TemplateReadOnlyPlaceholder": "#1a1a1a",
        "WordWrapMarker": "#222222"
    }
}
