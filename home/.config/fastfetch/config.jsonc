// fastfetch – 胡蝶しのぶ. Glowing Kochō crest, a quiet two-part list. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "kitty-direct", "source": "~/.config/fastfetch/crest.png", "width": 26, "height": 11, "padding": { "top": 1, "left": 2, "right": 4 } }, // LOGO (Settings → Theme)
  "display": {
    "separator": "  ",
    "color": { "keys": "#807a9c", "output": "#efeaf8" },
    "key": { "width": 11 },
    "percent": { "type": 3, "color": { "green": "#8fd6b8", "yellow": "#eec48e", "red": "#ec6f8f" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1;38;2;227;158;192}胡蝶しのぶ   {#0;38;2;64;58;92}──────────────  {#3;38;2;162;138;232}kochō" },
    "break",
    { "type": "os",       "key": "{#38;2;162;138;232} {#38;2;128;122;156}system", "format": "{name} · {#38;2;128;122;156}{kernel-release}" },
    { "type": "wm",       "key": "{#38;2;162;138;232} {#38;2;128;122;156}desk", "format": "{pretty-name} {version}" },
    { "type": "shell",    "key": "{#38;2;162;138;232} {#38;2;128;122;156}shell", "format": "fish · kitty" },
    { "type": "uptime",   "key": "{#38;2;162;138;232} {#38;2;128;122;156}awake" },
    "break",
    { "type": "cpu",      "key": "{#38;2;227;158;192} {#38;2;128;122;156}cpu", "format": "{name}  {#38;2;128;122;156}{temperature}", "temp": true },
    { "type": "gpu",      "key": "{#38;2;227;158;192} {#38;2;128;122;156}gpu", "format": "{name}" },
    { "type": "memory",   "key": "{#38;2;227;158;192} {#38;2;128;122;156}mem", "format": "{used} of {total}  {percentage}" },
    "break",
    { "type": "custom", "format": "{#38;2;162;138;232}━━━━ {#38;2;227;158;192}━━━━ {#38;2;127;196;227}━━━━ {#38;2;143;214;184}━━━━ {#38;2;238;196;142}━━━━ {#38;2;236;111;143}━━━━" }
  ]
}
