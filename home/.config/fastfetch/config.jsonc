// Tokyo Night fastfetch. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "color": { "1": "#7aa2f7", "2": "#bb9af7" }, "padding": { "right": 2 } },
  "display": { "separator": "  ", "color": { "keys": "#7aa2f7", "title": "#bb9af7" }, "key": { "width": 10 } },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;65;72;104m──────────────────────────────" },
    { "type": "os", "key": "󰣇 os" },
    { "type": "kernel", "key": " kernel" },
    { "type": "wm", "key": " wm" },
    { "type": "shell", "key": " shell" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu", "key": " cpu" },
    { "type": "gpu", "key": "󰢮 gpu" },
    { "type": "memory", "key": " ram" },
    { "type": "disk", "key": "󰋊 disk", "folders": "/" },
    { "type": "uptime", "key": "󰅐 up" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
