// fastfetch – Shinobu Kochō. Portrait on the left (kitty), a calm list on the right. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "kitty-direct", "source": "~/.config/fastfetch/logo.png", "width": 30, "height": 14, "padding": { "top": 1, "left": 3, "right": 4 } }, // LOGO (Settings → Theme)
  "display": {
    "separator": "  ",
    "color": { "keys": "#b69cf0", "separator": "#4a3f63", "output": "#ece4f6" },
    "key": { "width": 11 },
    "bar": { "char": { "elapsed": "━", "total": "━" }, "border": { "left": "", "right": "" }, "width": 12, "color": { "elapsed": "#e49bd8", "total": "#2d2640" } },
    "percent": { "type": 3, "color": { "green": "#9fdcc0", "yellow": "#f0c98a", "red": "#f27a9e" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#48;2;228;155;216}{#1;38;2;19;17;28}  胡蝶しのぶ  {#0}  {#3;38;2;125;114;153}the insect hashira{#0}" },
    "break",
    { "type": "os",       "key": "  os",      "format": "{pretty-name}" },
    { "type": "wm",       "key": "  wm",      "format": "{pretty-name} {version}" },
    { "type": "shell",    "key": "  shell",   "format": "{pretty-name}" },
    { "type": "terminal", "key": "  term",    "format": "{pretty-name}" },
    { "type": "uptime",   "key": "  up" },
    "break",
    { "type": "cpu",      "key": "  cpu",     "keyColor": "#e49bd8", "format": "{name}  {#38;2;125;114;153}{temperature}", "temp": true },
    { "type": "gpu",      "key": "  gpu",     "keyColor": "#e49bd8", "format": "{name}" },
    { "type": "memory",   "key": "  memory",  "keyColor": "#e49bd8", "format": "{percentage-bar}  {used} / {total}" },
    { "type": "disk",     "key": "  disk",    "keyColor": "#e49bd8", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total}" },
    "break",
    { "type": "custom", "format": "{#38;2;182;156;240}󱖉  {#38;2;228;155;216}󱖉  {#38;2;143;211;224}󱖉  {#38;2;159;220;192}󱖉  {#38;2;240;201;138}󱖉  {#38;2;242;122;158}󱖉" }
  ]
}
