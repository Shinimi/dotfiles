// fastfetch – Tokyo Night, your picture on the left (kitty), grouped info on the right. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",
    "width": 38,
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#7aa2f7", "title": "#bb9af7", "separator": "#414868", "output": "#c0caf5" },
    "key": { "width": 15 },
    "bar": { "char": { "elapsed": "━", "total": "─" }, "border": { "left": "", "right": "" }, "width": 12, "color": { "total": "#414868" } },
    "percent": { "type": 3, "color": { "green": "#9ece6a", "yellow": "#e0af68", "red": "#f7768e" } }
  },
  "modules": [
    { "type": "title", "format": "{#1;38;2;122;162;247}{user-name}{#0;38;2;65;72;104} @ {#1;38;2;187;154;247}{host-name}" },
    { "type": "custom", "format": "{#38;2;65;72;104}╭──────────────────────────── {#38;2;187;154;247}system {#38;2;65;72;104}──" },
    { "type": "os",       "key": "│ 󰣇  os",       "format": "{pretty-name}" },
    { "type": "kernel",   "key": "│   kernel",   "format": "{release}" },
    { "type": "wm",       "key": "│   wm",       "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "│ 󰏖  pkgs" },
    { "type": "uptime",   "key": "│ 󰅐  uptime" },
    { "type": "custom", "format": "{#38;2;65;72;104}├──────────────────────────── {#38;2;125;207;255}hardware {#38;2;65;72;104}─" },
    { "type": "cpu",      "key": "│ 󰻠  cpu",      "keyColor": "#7dcfff", "format": "{name} · {cores-logical}t · {temperature}", "temp": true },
    { "type": "gpu",      "key": "│ 󰢮  gpu",      "keyColor": "#7dcfff", "format": "{name}" },
    { "type": "memory",   "key": "│ 󰍛  memory",   "keyColor": "#7dcfff", "format": "{used} / {total}  {percentage-bar}" },
    { "type": "disk",     "key": "│ 󰋊  disk",     "keyColor": "#7dcfff", "folders": "/", "format": "{size-used} / {size-total}  {size-percentage-bar}" },
    { "type": "custom", "format": "{#38;2;65;72;104}├──────────────────────────── {#38;2;158;206;106}look {#38;2;65;72;104}─────" },
    { "type": "terminal", "key": "│   terminal", "keyColor": "#9ece6a" },
    { "type": "shell",    "key": "│   shell",    "keyColor": "#9ece6a" },
    { "type": "theme",    "key": "│ 󰏘  theme",    "keyColor": "#9ece6a", "format": "Tokyo Night glass" },
    { "type": "custom", "format": "{#38;2;65;72;104}╰──────────────────────────────────────────" },
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
