// fastfetch – monochrome · Guts. A katana in braille, a tree of what matters. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file-raw", "source": "~/.config/fastfetch/katana.txt", "padding": { "top": 0, "left": 2, "right": 5 } }, // LOGO (Settings → Theme)
  "display": {
    "separator": " ",
    "color": { "keys": "#6e6e6e", "output": "#e6e6e6" },
    "key": { "width": 12 },
    "bar": { "char": { "elapsed": "━", "total": "━" }, "border": { "left": "", "right": "" }, "width": 14, "color": { "elapsed": "#e6e6e6", "total": "#2e2e2e" } },
    "percent": { "type": ["bar", "num"], "color": { "green": "#bdbdbd", "yellow": "#e6e6e6", "red": "#cf6b6b" } }
  },
  "modules": [
    { "type": "custom", "format": "{#1;38;2;255;255;255}G U T S" },
    { "type": "custom", "format": "{#38;2;46;46;46}────────────────────────────────" },
    { "type": "custom", "format": "{#38;2;120;120;120}┌ {#38;2;200;200;200}hardware" },
    { "type": "cpu",    "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}cpu",  "format": "{name}  {#38;2;110;110;110}{temperature}", "temp": true },
    { "type": "gpu",    "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}gpu",  "format": "{name}" },
    { "type": "memory", "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}mem",  "format": "{percentage-bar} {#38;2;110;110;110}{used}" },
    { "type": "disk",   "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}disk", "folders": "/", "format": "{size-percentage-bar} {#38;2;110;110;110}{size-used}" },
    { "type": "custom", "format": "{#38;2;120;120;120}├ {#38;2;200;200;200}software" },
    { "type": "os",       "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}os",   "format": "{name} {#38;2;110;110;110}{kernel-release}" },
    { "type": "wm",       "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}wm",   "format": "{pretty-name} {version}" },
    { "type": "packages", "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}pkgs", "format": "{all}" },
    { "type": "uptime",   "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}up" },
    { "type": "media",    "key": "{#38;2;120;120;120}│  {#38;2;110;110;110}♪",    "format": "{title} {#38;2;110;110;110}· {artist}" },
    { "type": "custom", "format": "{#38;2;120;120;120}└ {#38;2;255;255;255}● {#38;2;200;200;200}● {#38;2;150;150;150}● {#38;2;100;100;100}● {#38;2;60;60;60}●" }
  ]
}
