// fastfetch – Shinobu Kochō: a butterfly, her name, a short list. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file-raw", "source": "~/.config/fastfetch/butterfly.txt", "padding": { "top": 2, "left": 3, "right": 5 } }, // LOGO (Settings → Theme)
  "display": {
    "separator": "   ",
    "color": { "keys": "#e39ec0", "output": "#efeaf8" },
    "key": { "width": 6 },
    "percent": { "type": 3, "color": { "green": "#8fd6b8", "yellow": "#eec48e", "red": "#ec6f8f" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1;38;2;162;138;232}胡 蝶 し の ぶ" },
    "break",
    { "type": "os",       "key": "os",   "format": "{name}" },
    { "type": "kernel",   "key": "ker",  "format": "{release}" },
    { "type": "wm",       "key": "wm",   "format": "{pretty-name}" },
    { "type": "shell",    "key": "sh",   "format": "{pretty-name}" },
    { "type": "memory",   "key": "mem",  "format": "{used} · {percentage}" },
    { "type": "uptime",   "key": "up" },
    "break",
    { "type": "custom", "format": "{#38;2;162;138;232}●  {#38;2;227;158;192}●  {#38;2;127;196;227}●  {#38;2;143;214;184}●  {#38;2;238;196;142}●  {#38;2;236;111;143}●" }
  ]
}
