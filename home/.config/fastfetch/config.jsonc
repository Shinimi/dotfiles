// fastfetch – monochrome. Glowing ring, a quiet two-part list. Made by Claude.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "kitty-direct", "source": "~/.config/fastfetch/mono.png", "width": 26, "height": 11, "padding": { "top": 1, "left": 2, "right": 4 } }, // LOGO (Settings → Theme)
  "display": {
    "separator": "  ",
    "color": { "keys": "#7a7a7a", "output": "#eaeaea" },
    "key": { "width": 11 },
    "percent": { "type": 3, "color": { "green": "#c8c8c8", "yellow": "#d6d6d6", "red": "#cf6b6b" } }
  },
  "modules": [
    "break",
    { "type": "custom", "format": "{#1;38;2;255;255;255}m o n o c h r o m e   {#0;38;2;58;58;58}────────────" },
    "break",
    { "type": "os",       "key": "{#38;2;200;200;200} {#38;2;110;110;110}system", "format": "{name} · {#38;2;110;110;110}{kernel-release}" },
    { "type": "wm",       "key": "{#38;2;200;200;200} {#38;2;110;110;110}desk", "format": "{pretty-name} {version}" },
    { "type": "shell",    "key": "{#38;2;200;200;200} {#38;2;110;110;110}shell", "format": "fish · kitty" },
    { "type": "uptime",   "key": "{#38;2;200;200;200} {#38;2;110;110;110}awake" },
    "break",
    { "type": "cpu",      "key": "{#38;2;150;150;150} {#38;2;110;110;110}cpu", "format": "{name}  {#38;2;110;110;110}{temperature}", "temp": true },
    { "type": "gpu",      "key": "{#38;2;150;150;150} {#38;2;110;110;110}gpu", "format": "{name}" },
    { "type": "memory",   "key": "{#38;2;150;150;150} {#38;2;110;110;110}mem", "format": "{used} of {total}  {percentage}" },
    "break",
    { "type": "custom", "format": "{#38;2;255;255;255}━━━━ {#38;2;200;200;200}━━━━ {#38;2;150;150;150}━━━━ {#38;2;100;100;100}━━━━ {#38;2;60;60;60}━━━━" }
  ]
}
