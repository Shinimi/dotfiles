layout {
    gaps 10
    center-focused-column "never"
    background-color "transparent"   // Noctalia draws the wallpaper underneath
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // monochrome, like Hyprland: a thin light border on the focused window, nothing on the rest
    focus-ring { off; }
    border {
        width 1
        active-gradient from="#e0e0e0" to="#7a7a7a" angle=45
        inactive-color "#2a2a2a"
        urgent-color "#ffffff"
    }
    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=6
        color "#00000080"
    }
    tab-indicator {
        active-color "#e0e0e0"
        inactive-color "#3a3a3a"
        width 3
        gap 4
    }
    struts { top 0; }
}
