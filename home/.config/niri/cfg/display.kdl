// Your two screens, side by side, tops aligned (same as Hyprland).
output "DP-1" {
    mode "2560x1440@144.000"
    position x=0 y=0
    scale 1
    variable-refresh-rate on-demand=true   // VRR only for fullscreen games, like Hyprland's vrr = 2
    focus-at-startup
}
output "DP-2" {
    mode "1920x1080@165.010"
    position x=2560 y=0
    scale 1
}

// The side screen keeps its own workspace for Discord, Spotify and Telegram.
workspace "side" { open-on-output "DP-2"; }
