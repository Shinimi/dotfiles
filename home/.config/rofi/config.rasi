/* rofi · monochrome minimal launcher. Made by Claude. */
@theme "/dev/null"
configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  drun-display-format: "{name}";
  font: "GeistMono Nerd Font 12";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
  click-to-exit: true;
}
* {
  bg:    #0b0b0bd9;
  fg:    #eaeaea;
  dim:   #555555;
  pink:  #b0b0b0;
  violet:#e0e0e0;
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 520px;
  background-color: transparent;
  border: 0;
}
mainbox {
  spacing: 14px;
  children: [ inputbar, sep, listview ];
  background-color: #111111e6;
  border: 1px; border-color: #ffffff14; border-radius: 18px;
  padding: 20px 16px 14px 16px;
}
inputbar { padding: 6px 8px; spacing: 12px; children: [ textbox-bf, entry ]; }
textbox-bf {
  expand: false; vertical-align: 0.5;
  text-color: @dim; font: "GeistMono Nerd Font 15";
  content: "󰍉";
}
entry {
  placeholder: "Search";
  cursor: text;
  placeholder-color: @dim;
  vertical-align: 0.5;
  font: "GeistMono Nerd Font 14";
}
sep { expand: false; content: ""; font: "GeistMono Nerd Font 1"; border: 0 0 1px 0; border-color: #b0b0b033; margin: 0 6px; }
listview { lines: 7; spacing: 2px; scrollbar: false; fixed-height: true; }
element { padding: 8px 10px; border-radius: 10px; spacing: 14px; cursor: pointer; }
element normal.normal, element alternate.normal, element normal.active, element alternate.active { background-color: transparent; text-color: #c8c8c8; }
element selected.normal, element selected.active { background-color: #e0e0e01f; text-color: @fg; }
element-icon { size: 22px; vertical-align: 0.5; }
element-text { text-color: inherit; vertical-align: 0.5; }
message { padding: 8px; }
