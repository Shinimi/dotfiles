// Waybar – Tokyo Night, main screen only. Made by Claude.
// Icons are written as \u escapes (JetBrainsMono Nerd Font) so they can't get lost.
{
  "layer": "top",
  "output": "DP-1",
  "position": "top",
  "height": 34,
  "spacing": 8,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left":   ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right":  ["mpris", "group/stats", "pulseaudio", "tray", "custom/notify", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip-format": "Apps (SUPER + Space)",
    "on-click": "rofi -show drun",
    "on-click-right": "rofi -show window"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": { "1": "1", "2": "2", "3": "3", "4": "4", "default": "{name}" },
    "persistent-workspaces": { "DP-1": [1, 2, 3, 4] },
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 45,
    "separate-outputs": true,
    "rewrite": { "": "Desktop" }
  },

  "clock": {
    "interval": 1,
    "format": "  {:%H:%M      %a %d %b}",
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "format": { "today": "<span color='#7aa2f7'><b>{}</b></span>" }
    }
  },

  "mpris": {
    "format": "  {artist} – {title}",
    "format-paused": "  {artist} – {title}",
    "max-length": 38,
    "ignored-players": ["firefox", "helium", "chromium"],
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  "group/stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature", "custom/gpu"]
  },
  "cpu": {
    "format": "  {usage}%",
    "interval": 2,
    "on-click": "kitty --class btop -e btop"
  },
  "memory": {
    "format": "  {percentage}%",
    "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GB",
    "interval": 3,
    "on-click": "kitty --class btop -e btop"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 85,
    "format": " {temperatureC}°",
    "tooltip-format": "CPU temperature",
    "interval": 3
  },
  "custom/gpu": {
    "exec": "~/.config/waybar/gpu.sh",
    "return-type": "json",
    "interval": 3
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "  muted",
    "format-icons": { "headphone": "", "default": ["", "", ""] },
    "scroll-step": 3,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc}"
  },

  "tray": { "icon-size": 16, "spacing": 10 },

  "custom/notify": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "none": "", "notification": "",
      "dnd-none": "", "dnd-notification": "",
      "inhibited-none": "", "inhibited-notification": "",
      "dnd-inhibited-none": "", "dnd-inhibited-notification": ""
    },
    "tooltip": false,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "Power menu  (right-click: lock)",
    "on-click": "~/.config/hypr/scripts/powermenu.sh",
    "on-click-right": "loginctl lock-session"
  }
}
