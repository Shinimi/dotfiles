# Theme: tokyo-night
# By: Pascal Jaeger

# Main bg
theme[main_bg]="#1a1726"

# Main text color
theme[main_fg]="#cfc9c2"

# Title color for boxes
theme[title]="#cfc9c2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8fd3e0"

# Background color of selected item in processes box
theme[selected_bg]="#4a3f63"

# Foreground color of selected item in processes box
theme[selected_fg]="#cfc9c2"

# Color of inactive/disabled text
theme[inactive_fg]="#7d7299"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#8fd3e0"

# Cpu box outline color
theme[cpu_box]="#7d7299"

# Memory/disks box outline color
theme[mem_box]="#7d7299"

# Net up/down box outline color
theme[net_box]="#7d7299"

# Processes box outline color
theme[proc_box]="#7d7299"

# Box divider line and small boxes line color
theme[div_line]="#7d7299"

# Temperature graph colors
theme[temp_start]="#9fdcc0"
theme[temp_mid]="#f0c98a"
theme[temp_end]="#f27a9e"

# CPU graph colors
theme[cpu_start]="#9fdcc0"
theme[cpu_mid]="#f0c98a"
theme[cpu_end]="#f27a9e"

# Mem/Disk free meter
theme[free_start]="#9fdcc0"
theme[free_mid]="#f0c98a"
theme[free_end]="#f27a9e"

# Mem/Disk cached meter
theme[cached_start]="#9fdcc0"
theme[cached_mid]="#f0c98a"
theme[cached_end]="#f27a9e"

# Mem/Disk available meter
theme[available_start]="#9fdcc0"
theme[available_mid]="#f0c98a"
theme[available_end]="#f27a9e"

# Mem/Disk used meter
theme[used_start]="#9fdcc0"
theme[used_mid]="#f0c98a"
theme[used_end]="#f27a9e"

# Download graph colors
theme[download_start]="#9fdcc0"
theme[download_mid]="#f0c98a"
theme[download_end]="#f27a9e"

# Upload graph colors
theme[upload_start]="#9fdcc0"
theme[upload_mid]="#f0c98a"
theme[upload_end]="#f27a9e"
